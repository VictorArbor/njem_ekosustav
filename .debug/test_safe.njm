# LSBU ISA v4 — SIGURNI TEST (bez skokova na offset 0)
mkm r10
wrt 1, "═══ LSBU ISA v4 — SIGURNI TEST ═══\n"

# ─── 1. OSNOVNI ───
nve r1, 12
nve r2, 10
pje r3, r1
nno

# ─── 2. SKUPOVNE (skalarne) ───
pis r4, r1, r2
ris r5, r1, r2
uis r6, r1, r2
srs r7, r1, r2

# ─── 3. BIT MANIPULACIJA ───
lpo r8, r1, 2
dpo r9, r1, 2
ibo r10, r1, 0, 4

# ─── 4. MEMORIJA ───
ssb r4, r10, 0
ujb r11, r10, 0

# ─── 5. USPOREDBA ───
ume r1, r2

# ─── 6. SPECIJALNI ───
nno
bar

# ─── 7. SISTEMSKI ───
wrt 1, "════════════════════════════════════════\n"

