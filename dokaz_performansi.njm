# ═══════════════════════════════════════════════════════════════════════════
#   NJM OS :: DOKAZ PERFORMANCE I SILIKONSKE SUPREMACIJE (dokaz_performansi.njm)
#   Nativni LSBU-S leksik bez C-runtimea (35 mnemonika)
# ═══════════════════════════════════════════════════════════════════════════

# 1. OTISAK MEMORIJE: Alokacija lokalne stogovne matrice (512 B)
mkm r10

# Priprema poruke o verifikaciji: "NJM_PERF_OK\n\0" na stogu
nve r2, 78;  ssb r2, r10, 0   # 'N'
nve r2, 74;  ssb r2, r10, 1   # 'J'
nve r2, 77;  ssb r2, r10, 2   # 'M'
nve r2, 95;  ssb r2, r10, 3   # '_'
nve r2, 80;  ssb r2, r10, 4   # 'P'
nve r2, 69;  ssb r2, r10, 5   # 'E'
nve r2, 82;  ssb r2, r10, 6   # 'R'
nve r2, 70;  ssb r2, r10, 7   # 'F'
nve r2, 95;  ssb r2, r10, 8   # '_'
nve r2, 79;  ssb r2, r10, 9   # 'O'
nve r2, 75;  ssb r2, r10, 10  # 'K'
nve r2, 10;  ssb r2, r10, 11  # '\n'
nve r2, 0;   ssb r2, r10, 12  # '\0'

# 2. BRZINA I PROTOČNOST: Petlja od 10.000.000 registarskih algebarskih ciklusa
nve r1, 43520                 # Testna bitna maska 1 (0xAA00)
nve r2, 21845                 # Testna bitna maska 2 (0x5555)
nve r3, 10000000              # Brojač petlje (10 milijuna iteracija)

PETLJA_PROTOČNOSTI:
# Skupovni algebarski takt bez C-funkcijskog overhead-a
uis r0, r1, r2                # Unija skupa (ORR)
pis r0, r0, r1                # Presjek skupa (AND)
srs r0, r0, r2                # Simetrična razlika (EOR)
ris r0, r0, r1                # Razlika skupa (BIC)

# Dekrementiranje i provjera nule
odu r3, r3, 1                 # r3 = r3 - 1
gnn r3, PETLJA_PROTOČNOSTI    # Skok ako r3 != 0

# 3. PRECIZNOST I INTEGRITET: Algebarski dokaz jednakosti (Zero-Float)
nve r4, 100
nve r5, 100
ume r4, r5                    # Usporedba r4 i r5 (CMP)
# Akumulacija stanja u r0
nve r0, 0

# 4. IZLAZ NA EKRAN: NATIVNI KERNEL SYSCALL (sys_write #64)
# Mjerenje: Ispisujemo potvrdu o završenoj masenoj obradi bez C biblioteka
sab r1, r10, 0                # Adresa linije na stogu
wrt 1, r1, 12                 # Pisanje 12 bajtova direktno na stdout (fd=1)

# Clean Exit (sys_exit #93)
pir
