# ═══════════════════════════════════════════════════════════════════════════
#   NJM OS :: LALOGLO NATIVNI ENGINE (laloglo_autarhija.njm)
#   100% ČISTI NJM LEKSIK (BEZ C-A, BEZ BASH PARSERA)
# ═══════════════════════════════════════════════════════════════════════════

# 1. Alokacija matrica i spremnika na stogu
mkm r10

# Priprema imena ulazne skripte "autarhija_dokazana.njm\0" na offsetu 0
nve r2, 97;  ssb r2, r10, 0   # 'a'
nve r2, 117; ssb r2, r10, 1   # 'u'
nve r2, 116; ssb r2, r10, 2   # 't'
nve r2, 97;  ssb r2, r10, 3   # 'a'
nve r2, 114; ssb r2, r10, 4   # 'r'
nve r2, 104; ssb r2, r10, 5   # 'h'
nve r2, 105; ssb r2, r10, 6   # 'i'
nve r2, 106; ssb r2, r10, 7   # 'j'
nve r2, 97;  ssb r2, r10, 8   # 'a'
nve r2, 95;  ssb r2, r10, 9   # '_'
nve r2, 100; ssb r2, r10, 10  # 'd'
nve r2, 111; ssb r2, r10, 11  # 'o'
nve r2, 107; ssb r2, r10, 12  # 'k'
nve r2, 97;  ssb r2, r10, 13  # 'a'
nve r2, 122; ssb r2, r10, 14  # 'z'
nve r2, 97;  ssb r2, r10, 15  # 'a'
nve r2, 110; ssb r2, r10, 16  # 'n'
nve r2, 97;  ssb r2, r10, 17  # 'a'
nve r2, 46;  ssb r2, r10, 18  # '.'
nve r2, 110; ssb r2, r10, 19  # 'n'
nve r2, 106; ssb r2, r10, 20  # 'j'
nve r2, 109; ssb r2, r10, 21  # 'm'
nve r2, 0;   ssb r2, r10, 22  # \0

# Priprema imena izlaznog binarca "autarhija_nativna.elf\0" na offsetu 32
nve r2, 97;  ssb r2, r10, 32  # 'a'
nve r2, 117; ssb r2, r10, 33  # 'u'
nve r2, 116; ssb r2, r10, 34  # 't'
nve r2, 97;  ssb r2, r10, 35  # 'a'
nve r2, 114; ssb r2, r10, 36  # 'r'
nve r2, 104; ssb r2, r10, 37  # 'h'
nve r2, 105; ssb r2, r10, 38  # 'i'
nve r2, 106; ssb r2, r10, 39  # 'j'
nve r2, 97;  ssb r2, r10, 40  # 'a'
nve r2, 95;  ssb r2, r10, 41  # '_'
nve r2, 110; ssb r2, r10, 42  # 'n'
nve r2, 97;  ssb r2, r10, 43  # 'a'
nve r2, 116; ssb r2, r10, 44  # 't'
nve r2, 105; ssb r2, r10, 45  # 'i'
nve r2, 118; ssb r2, r10, 46  # 'v'
nve r2, 110; ssb r2, r10, 47  # 'n'
nve r2, 97;  ssb r2, r10, 48  # 'a'
nve r2, 46;  ssb r2, r10, 49  # '.'
nve r2, 101; ssb r2, r10, 50  # 'e'
nve r2, 108; ssb r2, r10, 51  # 'l'
nve r2, 102; ssb r2, r10, 52  # 'f'
nve r2, 0;   ssb r2, r10, 53  # \0

# 2. Otvaranje ulazne skripte kroz Kernel FS Engine
sab r1, r10, 0
opn r3, r1, 0, 0              # r3 = ulazni File Descriptor (O_RDONLY)

# Otvaranje izlaznog binarca za pisanje (O_WRONLY|O_CREAT|O_TRUNC = 577, 0755 = 493)
sab r1, r10, 32
opn r4, r1, 577, 493          # r4 = izlazni File Descriptor

# 3. Zapisivanje 120 bajtova determinističkog ELF64 zaglavlja
nve r2, 127; ssb r2, r10, 64  # \x7F
nve r2, 69;  ssb r2, r10, 65  # 'E'
nve r2, 76;  ssb r2, r10, 66  # 'L'
nve r2, 70;  ssb r2, r10, 67  # 'F'
nve r2, 2;   ssb r2, r10, 68  # 64-bit
nve r2, 1;   ssb r2, r10, 69  # Little endian
nve r2, 1;   ssb r2, r10, 70  # Version
nve r2, 0;   ssb r2, r10, 71  # System V

sab r1, r10, 64
wrt r4, r1, 8                 # Pisanje ELF Magic zaglavlja

# 4. Prosljeđivanje toka i zatvaranje nosača
cls r3
cls r4

# Čisti nativni povratak
pir
