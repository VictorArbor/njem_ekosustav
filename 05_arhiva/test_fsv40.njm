# 1. Alokacija scratchpada
mkm r10

# 2. Konstrukcija naziva "autarhija.txt\0" u stogu [r10 + 0..13]
nve r2, 97    # 'a'
ssb r2, r10, 0
nve r2, 117   # 'u'
ssb r2, r10, 1
nve r2, 116   # 't'
ssb r2, r10, 2
nve r2, 97    # 'a'
ssb r2, r10, 3
nve r2, 114   # 'r'
ssb r2, r10, 4
nve r2, 104   # 'h'
ssb r2, r10, 5
nve r2, 105   # 'i'
ssb r2, r10, 6
nve r2, 106   # 'j'
ssb r2, r10, 7
nve r2, 97    # 'a'
ssb r2, r10, 8
nve r2, 46    # '.'
ssb r2, r10, 9
nve r2, 116   # 't'
ssb r2, r10, 10
nve r2, 120   # 'x'
ssb r2, r10, 11
nve r2, 116   # 't'
ssb r2, r10, 12
nve r2, 0     # null terminator
ssb r2, r10, 13

# 3. Zapisujemo sadržaj 'A' (65) na pomak [r10 + 16]
nve r3, 65    # ASCII 'A'
ssb r3, r10, 16

# 4. Otvaramo datoteku za pisanje (O_WRONLY | O_CREAT | O_TRUNC = 577, mode = 0644 = 420)
nve r2, 577   # flags
opn r1, r10, r2, 420

# 5. Upisujemo 1 bajt u datoteku iz [r10 + 16]
mkm r4
# Adresa spremnika u r4 (r10 + 16)
sab r4, r10, r4
nve r5, 16
sab r4, r10, r5
nve r6, 1     # count = 1 bajt
wrt r1, r4, r6

# 6. Zatvaramo datoteku
cls r1

# 7. Ponovno otvaramo za čitanje (O_RDONLY = 0)
nve r2, 0
opn r1, r10, r2, 0

# 8. Čitamo 1 bajt iz datoteke natrag u [r10 + 32]
nve r5, 32
sab r4, r10, r5
rdl r1, r4, r6

# 9. Zatvaramo datoteku i dohvaćamo 'A' (65) u r0
cls r1
ujb r0, r4, 0
pir
