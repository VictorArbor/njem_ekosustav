# ═══════════════════════════════════════════════════════════════════════════
#   3. LALOGLOSATOR V7 AUTOPOIESIS ENGINE (LSBU-S Exec / FS Engine)
# ═══════════════════════════════════════════════════════════════════════════

# Alokacija radne matrice na stogu
mkm r10

# Priprema imena izlaznog dinamičkog toka "autopoiesis.lsbu\0" na offsetu 0
nve r2, 97;  ssb r2, r10, 0   # 'a'
nve r2, 117; ssb r2, r10, 1   # 'u'
nve r2, 116; ssb r2, r10, 2   # 't'
nve r2, 111; ssb r2, r10, 3   # 'o'
nve r2, 46;  ssb r2, r10, 4   # '.'
nve r2, 108; ssb r2, r10, 5   # 'l'
nve r2, 115; ssb r2, r10, 6   # 's'
nve r2, 98;  ssb r2, r10, 7   # 'b'
nve r2, 117; ssb r2, r10, 8   # 'u'
nve r2, 0;   ssb r2, r10, 9   # \0

# Otvaranje/stvaranje datoteke na disku kroz nativni FS engine
sab r1, r10, 0
opn r3, r1, 577, 493         # O_WRONLY|O_CREAT|O_TRUNC (577), mode 0755 (493)

# Pisanje generiranog uzorka binarne mase direktno u datoteku
nve r2, 83;  ssb r2, r10, 16  # 'S'
nve r2, 66;  ssb r2, r10, 17  # 'B'
nve r2, 85;  ssb r2, r10, 18  # 'U'
nve r2, 10;  ssb r2, r10, 19  # '\n'

sab r1, r10, 16
wrt r3, r1, 4                # Pisanje 4 bajta na disk

# Zatvaranje deskriptora i čisti povratak
cls r3
pir
